# =========================================================
# Sambal Mama Ana — Contoh konfigurasi environment
# Salin file ini menjadi `.env` lalu isi nilainya:
#   cp .env.example .env  (Windows: copy .env.example .env)
# =========================================================

# --- Database (MySQL) untuk Prisma ----------------------
DATABASE_URL="mysql://root:@localhost:3306/sambal_mama_ana"

# --- Autentikasi (NextAuth v5) ---------------------------
# Buat secret baru dengan: npx auth secret
AUTH_SECRET="ganti-dengan-secret-acak"
AUTH_TRUST_HOST=true

# --- URL aplikasi ----------------------------------------
# Dipakai untuk tautan di email (verifikasi & reset password).
APP_URL="http://localhost:3000"

# --- SMTP (opsional) --------------------------------------
# Jika SMTP_HOST/SMTP_USER kosong, email hanya dicetak ke
# console (mode pengembangan).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Sambal Mama Ana <noreply@sambalmamaana.local>"

# --- Opsi seeding (opsional, hanya untuk npm run db:seed) -
# SEED_ADMIN_EMAIL=admin@sambalmamaana.local
# SEED_ADMIN_PASSWORD=MamaAna!2026